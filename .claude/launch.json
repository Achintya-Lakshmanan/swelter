{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "swelter",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "server.py"
      ],
      "port": 8000
    },
    {
      "name": "swelter-dev",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--env-file",
        ".env",
        "server.py"
      ],
      "env": {
        "SWELTER_DEV_LOGIN": "1"
      },
      "port": 8000
    }
  ]
}
