# Copy to .env and fill in. Every key is optional: without it the matching feature turns off and the app says so.

# Auth0: residents and volunteers on the phone, government on the planner web page. Step by step: docs/auth0-setup.md
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=                          # Native app (iPhone)
AUTH0_WEB_CLIENT_ID=                      # Single Page Application (planner web page)
AUTH0_AUDIENCE=https://api.swelter.app
# AUTH0_RESPONDER_ROLE=respond:requests   # accounts whose token has this permission (RBAC) are volunteers
# AUTH0_GOVERNMENT_ROLE=view:planner      # ... and this one, government
# SWELTER_RESPONDERS=a@example.org,b@example.org   # or list emails (needs an email claim on the token)
# SWELTER_GOVERNMENT=c@example.org
# SWELTER_DEV_LOGIN=1                     # demo accounts Kayla, Marisol Rivera, Jordan Ellis; not for production

# Tiger Data / Timescale Cloud: phone data (presence pings as a hypertable) and the simulation tables the Ask chat
# queries (schema sim). Unset = SQLite at data/swelter.db and data/simulation.db
DATABASE_URL=

# ElevenLabs (spoken alerts / site directions)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Gemini (the planner page's Ask chat: question -> SQL -> answer)
GEMINI_API_KEY=
# GEMINI_SQL_MODEL=gemini-3.5-flash

# Claude (the web demo's "Why?" explainer)
ANTHROPIC_API_KEY=
