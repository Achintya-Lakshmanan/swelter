# Copy to .env and fill in. Every key is optional: without it the matching feature turns off and the app says so.

# Auth0 (resident and responder sign-in). Native app + API in your tenant; callback: app.swelter.Swelter://<domain>/ios/app.swelter.Swelter/callback
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://api.swelter.app
# AUTH0_RESPONDER_ROLE=respond:requests   # accounts whose token has this permission (RBAC) are responders
# SWELTER_RESPONDERS=a@example.org,b@example.org   # or list responder emails (needs an email claim on the token)
# SWELTER_DEV_LOGIN=1                     # demo accounts Kayla (resident) and Marisol Rivera (responder); not for production

# Tiger Data / Timescale Cloud (presence pings as a hypertable). Unset = SQLite at data/swelter.db
DATABASE_URL=

# ElevenLabs (spoken alerts / site directions)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Gemini (Spanish alert text)
GEMINI_API_KEY=

# Claude (the web demo's "Why?" explainer)
ANTHROPIC_API_KEY=
